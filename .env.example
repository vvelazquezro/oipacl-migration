# Copy to .env and fill in real values. .env is gitignored and must never be committed.
FLASK_SECRET_KEY=change-me-to-a-long-random-value
APP_ROOT_PATH=/ss-migrator
SESSION_COOKIE_SECURE=true
MAX_CONCURRENT_JOBS=5
MAX_PROPERTIES_PER_JOB=1000
CREDENTIAL_TTL_SECONDS=3600
# Set to false only for local dev without a GSAP Gateway in front; never disable in production.
REQUIRE_GSAP_AUTH=true
ALLOWED_EMAIL_DOMAIN=akamai.com
